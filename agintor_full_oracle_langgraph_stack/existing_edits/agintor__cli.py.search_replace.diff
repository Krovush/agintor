@app.command("oracle-qa")
def oracle_qa_cmd(package_dir: str) -> None:
    package = load_oracle_package(package_dir)
    report = qa_oracle_package(package)
    typer.echo(json.dumps(report.model_dump(mode="json", exclude_none=True), indent=2, sort_keys=True))


@app.command("inspect-oracle")
def inspect_oracle_cmd(package_dir: str, public: bool = typer.Option(False, "--public")) -> None:
    package = load_oracle_package(package_dir)
    payload = package.model_dump(mode="json", exclude_none=True)
    if public:
        from .contracts import oracle_public_projection
        payload = oracle_public_projection(package)
    typer.echo(json.dumps(payload, indent=2, sort_keys=True))


