@app.command("init-runtime")
def init_runtime_cmd(
    destination: str,
    force: bool = typer.Option(False, "--force"),
    write_suite: Optional[str] = typer.Option(None, "--write-demo-suite"),
    runtime_kind: str = typer.Option("policy_file_v1", "--runtime-kind"),
) -> None:
    if runtime_kind in {"langgraph_spec_v2", "tradingagents_langgraph_v1"}:
        spec = baseline_langgraph_runtime_spec(runtime_id=f"runtime.{Path(destination).name}")
        path = RuntimeSpecCompiler().compile_to_directory(spec, destination, force=force)
        payload = {"runtime_dir": str(path), "runtime_kind": runtime_kind, "runtime_spec_digest": spec.spec_digest}
        typer.echo(json.dumps(payload, indent=2))
        return
    path = init_runtime_dir(destination, force=force)
