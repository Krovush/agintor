    @staticmethod
    def _claim_evidence_issue(claim_results: Sequence[ClaimResult | Mapping[str, Any]]) -> str:
        for raw in claim_results:
            claim = raw if isinstance(raw, ClaimResult) else ClaimResult.model_validate(dict(raw))
            if claim.satisfied is False:
                return "critical_claim_failed"
            if claim.satisfied is None and claim.residual_unverified:
                return "critical_claim_unverified"
            if claim.coverage < 1.0 and claim.residual_unverified:
                return "critical_claim_unverified"
        return ""

